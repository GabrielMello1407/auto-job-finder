# Copie para .env só se quiser mudar algo. Sem .env, o agente detecta sozinho a IA disponível.

# ---------------------------------------------------------------------------
# IA (provedor)
# ---------------------------------------------------------------------------
# Vazio = detecção automática, nesta ordem:
#   claude-code  assinatura Claude Pro/Max (CLI `claude`)            — sem custo extra
#   codex        assinatura ChatGPT Plus/Pro (CLI `codex`)           — sem custo extra
#   gemini-cli   conta Google (CLI `gemini`)                         — sem custo extra
#   anthropic    API Anthropic (ANTHROPIC_API_KEY)                   — paga por uso
#   bedrock      Claude no Amazon Bedrock (credenciais AWS)          — paga por uso, sem busca web
#   vertex       Claude no Google Cloud Vertex AI                    — paga por uso
#   openai       API OpenAI ou compatível (OpenRouter, Groq, Ollama) — paga por uso
#   gemini       API Gemini (Google AI Studio)                       — paga por uso / cota grátis
# Para escolher pelo menu: `ajf ia --escolher` (grava aqui).
AJF_PROVIDER=

# Modelo principal e da triagem. Vazio = padrão do provedor (nas CLIs, o padrão da sua conta).
# Exemplos: claude-opus-5-5 / sonnet · gpt-5 · gemini-2.5-pro · anthropic.claude-opus-5-5 (Bedrock)
AJF_MODEL=
AJF_TRIAGE_MODEL=

# Executáveis das CLIs, se não estiverem no PATH
AJF_CLAUDE_BIN=
AJF_CODEX_BIN=
AJF_GEMINI_BIN=

# --- APIs (preencha só a que for usar) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Endpoint compatível com OpenAI (ex.: https://openrouter.ai/api/v1, http://localhost:11434/v1)
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Bedrock: AWS_REGION + (AWS_BEARER_TOKEN_BEDROCK ou AWS_PROFILE ou chaves AWS)
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
# Vertex: projeto + região, login com `gcloud auth application-default login`
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=

# ---------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------
# Pasta com perfil/vagas/pacotes de UMA pessoa. Vazio = a pasta do projeto.
AJF_HOME=
# Loop hiring manager ⇄ editor
AJF_TARGET_RATING=8.5
AJF_MAX_REVISIONS=3
# Nota final mínima para o pacote valer a pena enviar
AJF_MIN_RATING=7
# Nota mínima da triagem (0–100) para o piloto automático gerar pacote
AJF_MIN_TRIAGE_SCORE=70
# Fallback automático quando o modelo recusa (só API Anthropic). on/off
AJF_FALLBACKS=on
# Token do GitHub (opcional): mais limite para a fonte github-br e para ler perfis no init
GITHUB_TOKEN=
# Chrome/Edge para gerar PDF (detectado automaticamente)
CHROME_PATH=
