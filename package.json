{
  "name": "auto-job-finder",
  "version": "1.0.0",
  "private": true,
  "description": "AI job-application agent for any field: builds your profile (resume, LinkedIn, portfolio), finds jobs, tailors an ATS resume, cover letter, e-mails and LinkedIn. Works with Claude, ChatGPT/Codex, Gemini or APIs.",
  "license": "MIT",
  "author": "Gabriel Mello Moraes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielMello1407/auto-job-finder.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielMello1407/auto-job-finder/issues"
  },
  "homepage": "https://github.com/GabrielMello1407/auto-job-finder#readme",
  "keywords": [
    "vagas",
    "curriculo",
    "ats",
    "job-search",
    "resume",
    "cover-letter",
    "llm",
    "claude",
    "openai",
    "gemini"
  ],
  "type": "module",
  "scripts": {
    "ajf": "tsx src/cli.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "i18n": "tsx scripts/i18n.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.4.0",
    "@anthropic-ai/vertex-sdk": "^1.1.1",
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "mammoth": "^1.13.0",
    "puppeteer-core": "^25.16.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "ajf": "./bin/ajf.mjs"
  }
}
